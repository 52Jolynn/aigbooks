# AIGBooks 数据库配置：切换 PG / SQLite / MySQL 任一种即可
# 默认 PG；开发/演示用 SQLite；MySQL 走兼容协议的服务端（如 OceanBase seekdb）
# AIGBOOKS_DATABASE_URL=postgresql+asyncpg://aigbooks:aigbooks@localhost:5432/aigbooks
# AIGBOOKS_DATABASE_URL=sqlite+aiosqlite:///./var/aigbooks.db
# AIGBOOKS_DATABASE_URL=mysql+asyncmy://aigbooks:aigbooks@localhost:3306/aigbooks
AIGBOOKS_DATABASE_URL=postgresql+asyncpg://aigbooks:aigbooks@localhost:5432/aigbooks
AIGBOOKS_DATABASE_ECHO=false

AIGBOOKS_EVIDENCE_DIR=/var/lib/aigbooks/evidence
AIGBOOKS_COVERS_DIR=/var/lib/aigbooks/covers
AIGBOOKS_MAX_UPLOAD_SIZE=20971520
AIGBOOKS_REPORT_RATE_LIMIT=5
AIGBOOKS_REPORT_RATE_WINDOW=3600
AIGBOOKS_PAGE_SIZE=20
AIGBOOKS_CORS_ORIGINS=["http://localhost:3000"]